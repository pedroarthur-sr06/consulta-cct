                                                                    <label class="textogrupo">
                                                                        ANEXO II - ATA DA ASSEMBLEIA GERAL
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

