                                                                        ANEXO I - ATA DE DELIBERA&#199;&#195;O FINAL APROVA&#199;&#195;O CCT 2025-2027
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
