                                        <br />
                                        <center>
                                            <label class="textogrupo">
                                                <b>ANEXOS </b>
                                            </label>
                                        </center>
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO I - ATA ASSEMBLEIA GERAL - TRABALHADORES
                                                                    </label>
                                                                </center>
                                                                <label class="tituloClausula">
                                                                                                                                    </label>
                                                            </b>
                                                        </label>
                                                        <b>
                                                            <label>

                                                            </label>
                                                        </b>
                                                        <br />
                                                        <label class="descricaoClausula" >
                                                            <p><a href="https://www3.mte.gov.br/sistemas/mediador/imagemAnexo/MR024062_20252025_05_07T11_39_24.pdf" target="_blank">Anexo (PDF)</a></p>
                                                        </label>
                                                        <br />
                                                        <label>
                                                            <b>
                                                                <center>
                                                                    <label class="textogrupo">
                                                                        ANEXO II - ATA ASSEMBLEIA GERAL - EMPREGADORES
                                                                    </label>
                                                                </center>
